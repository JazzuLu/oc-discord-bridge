# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional allowlist (recommended)
# Comma-separated Discord user IDs.
DISCORD_ALLOW_USER_IDS=

# Behavior
DISCORD_IGNORE_BOTS=true
DISCORD_IGNORE_CHANNELS_WITHOUT_CWD=true

# Optional: redact common secret patterns in logs + Discord echoes.
# Default false to avoid surprising output changes.
REDACT_SECRETS=false

# Optional: explicit default cwd if a channel has no CWD=... (usually leave empty)
OPENCODE_DEFAULT_CWD=

# OpenCode
OPENCODE_BIN=opencode
# If true, the bridge will start its own opencode acp process.
OPENCODE_ACP_AUTOSTART=true
# Optional fixed ACP bind; 0 lets opencode pick a random port.
OPENCODE_ACP_HOSTNAME=127.0.0.1
OPENCODE_ACP_PORT=0

# Storage
DATA_DIR=.data
