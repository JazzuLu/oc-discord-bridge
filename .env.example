# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional allowlist (recommended)
# Comma-separated Discord user IDs.
DISCORD_ALLOW_USER_IDS=

# Optional: restrict the bridge to an explicit set of parent channel IDs.
# (Threads are allowed iff their parent channel is allowed.)
# Comma-separated Discord channel IDs.
DISCORD_ALLOW_CHANNEL_IDS=

# Optional role-based allowlist.
# Applies to /oc and message forwarding.
# Comma-separated Discord role IDs.
DISCORD_ALLOW_ROLE_IDS=

# Optional: security hardening (opt-in). When true, deny by default unless an allowlist matches.
DISCORD_DEFAULT_DENY=false

# Behavior
DISCORD_IGNORE_BOTS=true
DISCORD_IGNORE_CHANNELS_WITHOUT_CWD=true

# Optional: restrict channel CWD to these allowed absolute prefixes.
# Comma-separated list. Example:
# DISCORD_ALLOWED_CWD_PREFIXES=/Users/pancraslu/WorkingPlace,/tmp
DISCORD_ALLOWED_CWD_PREFIXES=

# Optional: redact common secret patterns in logs + Discord echoes.
# Default false to avoid surprising output changes.
REDACT_SECRETS=false

# Optional: explicit default cwd if a channel has no CWD=... (usually leave empty)
OPENCODE_DEFAULT_CWD=

# OpenCode
OPENCODE_BIN=opencode
# If true, the bridge will start its own opencode acp process.
OPENCODE_ACP_AUTOSTART=true

# Storage
DATA_DIR=.data
