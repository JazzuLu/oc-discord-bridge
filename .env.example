# oc-discord-bridge – example configuration
#
# Copy to ../.env (repo root) because src/index.ts loads dotenv from "../.env".
#   cp .env.example .env
#
# Required
DISCORD_BOT_TOKEN=

# Recommended (guild-scoped slash command registration; faster iteration)
DISCORD_GUILD_ID=

# Optional allowlists (comma-separated IDs)
# - If you set any allowlist, only matching users/roles/channels can use /oc and message forwarding.
# - If all allowlists are empty and DISCORD_DEFAULT_DENY=false (default), the bridge is default-open.
DISCORD_ALLOW_USER_IDS=
DISCORD_ALLOW_ROLE_IDS=
# Parent channel IDs only; threads are allowed iff their parent channel is allowed.
DISCORD_ALLOW_CHANNEL_IDS=

# Security hardening (opt-in)
# When true, and all allowlists are empty, deny /oc + forwarding by default.
DISCORD_DEFAULT_DENY=false

# Safety / behavior
DISCORD_IGNORE_BOTS=true
# When true, channels without CWD= in topic (or /oc cwd) are ignored.
DISCORD_IGNORE_CHANNELS_WITHOUT_CWD=true
# Optional: restrict which absolute directories can be used as CWD=.
# Example (macOS): /Users/pancraslu/WorkingPlace,/Users/pancraslu/Projects
DISCORD_ALLOWED_CWD_PREFIXES=

# Optional: redact common token patterns in logs and in text echoed back to Discord.
REDACT_SECRETS=false

# OpenCode / ACP
OPENCODE_BIN=opencode
OPENCODE_ACP_AUTOSTART=true
# If set, this is used when no channel CWD mapping exists.
OPENCODE_DEFAULT_CWD=

# Data directory for persisted state files (relative to process cwd)
DATA_DIR=.data
